<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Bloque de contenido normal (Visor + Barra IP) -->
    <LinearLayout
        android:id="@+id/layoutPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior discreta para configurar la IP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#1E1E1E">

            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="IP del Servidor (Ej: 192.168.1.151:8000)"
                android:text="192.168.1.151:8000"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:inputType="text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnScanQR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 QR"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONECTAR"
                android:backgroundTint="#00C853"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- El visor web estándar -->
        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Reproductor de Video para la Publicidad (Oculto al inicio) -->
    <VideoView
        android:id="@+id/videoPublicidad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
